{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["app/*"]
    },
    "strict": true,
    "types": ["jest"]
  },
  "include": ["app", "src", "__tests__", "jest.setup.ts"]
}
